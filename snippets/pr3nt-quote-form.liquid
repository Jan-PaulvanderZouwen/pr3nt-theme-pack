<div class="p-form">
  <style>
    .p-upload-progress{margin-top:14px;padding:14px;border-radius:18px;background:#fff;border:1px solid rgba(16,24,32,.08);display:grid;grid-template-columns:62px 1fr;gap:12px;align-items:center;box-shadow:0 10px 28px rgba(16,24,32,.04)}
    .p-upload-progress[hidden]{display:none!important}
    .p-mini-printer{position:relative;width:62px;height:48px;border-radius:14px;background:#101820;overflow:hidden}
    .p-mini-printer span{position:absolute;left:8px;right:8px;top:10px;height:4px;border-radius:999px;background:rgba(255,255,255,.7)}
    .p-mini-printer i{position:absolute;top:6px;left:10px;width:18px;height:16px;border-radius:6px;background:#00d084;animation:pQuotePrinterHead 1.35s infinite alternate ease-in-out}
    .p-mini-printer b{position:absolute;left:18px;right:18px;bottom:10px;height:8px;border-radius:8px 8px 3px 3px;background:#00d084;animation:pQuotePrintGrow 1.35s infinite alternate ease-in-out}
    .p-upload-progress-copy{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:baseline;min-width:0}
    .p-upload-progress-copy strong{font-size:14px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .p-upload-progress-copy span{color:rgba(16,24,32,.55);font-size:13px;font-weight:900}
    .p-upload-progress-bar{grid-column:2;border-radius:999px;background:rgba(16,24,32,.08);height:9px;overflow:hidden}
    .p-upload-progress-bar span{display:block;height:100%;width:0;background:#00d084;border-radius:inherit;transition:width .18s ease}
    @keyframes pQuotePrinterHead{from{left:9px}to{left:34px}}
    @keyframes pQuotePrintGrow{from{height:4px}to{height:16px}}
    @media(max-width:640px){.p-upload-progress{grid-template-columns:52px 1fr;padding:12px}.p-mini-printer{width:52px;height:44px}.p-upload-progress-bar{grid-column:1/-1}}
  </style>
  {% assign pr3nt_form_id = form_id | default: 'Pr3ntQuoteForm' %}
  <form id="{{ pr3nt_form_id }}" data-pr3nt-form data-p-endpoint="{{ quote_endpoint_url | default: '' }}" novalidate>
    <input type="hidden" value="PLA" data-p-material-input>
    <input type="hidden" value="Nee" data-p-rush-input>
    <input type="hidden" value="" data-p-file-name>

    <div class="p-form-head">
      <div>
        <p class="p-form-kicker">{{ form_kicker | default: 'Binnen 2 stappen jouw print geregeld' }}</p>
        <h2 class="p-form-title" data-p-form-title>Materiaal & bestand</h2>
      </div>
      <div class="p-iconbox" data-p-step-icon>1</div>
    </div>

    <div class="p-step-tabs">
      <button type="button" class="p-step-tab is-active" data-p-tab="1"><small>Stap 1</small><strong>Materiaal & bestand</strong></button>
      <button type="button" class="p-step-tab" data-p-tab="2"><small>Stap 2</small><strong>Gegevens</strong></button>
    </div>

    <div class="p-form-step" data-p-step="1">
      <label class="p-upload">
        <span style="font-size:30px">↑</span>
        <strong data-p-file-label>Sleep je 3D-bestand hierheen</strong>
        <span class="p-upload-help">Ondersteund: {{ supported_formats | default: 'STL, 3MF, OBJ, STEP of STP' }}</span>
        <span class="p-btn p-btn-dark p-upload-button">Bestand kiezen</span>
        <input class="p-file-input" type="file" accept=".stl,.3mf,.obj,.step,.stp" data-p-file multiple>
      </label>
      <div class="p-error" data-p-file-error>Upload een geldig 3D-bestand.</div>

      <div class="p-field-grid">
        <div class="p-field">
          <span>Materiaal</span>
          <div class="p-choice-grid">
            <button type="button" class="p-choice is-active" data-p-material="PLA">PLA</button>
            <button type="button" class="p-choice" data-p-material="PETG">PETG</button>
          </div>
        </div>
        <label class="p-field">
          <span>Gewenste kleur</span>
          <input type="text" placeholder="Bijv. zwart, wit, rood..." required data-p-color>
        </label>
      </div>

      <button type="button" class="p-rush" data-p-rush><strong>Spoed aanvragen</strong><span data-p-rush-text>Standaard · 3 dagen verzending</span></button>
      <button type="button" class="p-btn p-btn-primary" style="width:100%;margin-top:18px" data-p-next disabled>Verder naar gegevens</button>
    </div>

    <div class="p-form-step" data-p-step="2" hidden>
      <div class="p-summary p-summary-field" style="margin-top:10px;padding:11px 12px;border-radius:16px">
        <div class="p-summary-row" style="display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px;flex-wrap:nowrap">
          <div class="p-summary-main" style="min-width:0;line-height:1.35" data-p-summary></div>
          <button type="button" class="p-btn p-btn-outline" style="min-height:38px;padding:8px 13px;width:auto;font-size:13px" data-p-change>Wijzig</button>
        </div>
      </div>

      <div class="p-contact-group" style="padding:16px;background:#fff;border-color:rgba(16,24,32,.07);gap:12px">
        <p class="p-contact-group-title">Contactgegevens</p>
        <label class="p-field" style="padding:0;border:0;background:transparent;border-radius:0"><span style="margin-bottom:6px">E-mailadres</span><input type="email" style="min-height:52px" placeholder="jij@example.nl" required data-p-email></label>
        <label class="p-field" style="padding:0;border:0;background:transparent;border-radius:0"><span style="margin-bottom:6px">Naam</span><input type="text" style="min-height:52px" placeholder="Je naam" required data-p-name></label>
        <label class="p-field" style="padding:0;border:0;background:transparent;border-radius:0"><span style="margin-bottom:6px">Telefoonnummer <small>(optioneel)</small></span><input type="tel" style="min-height:52px" placeholder="Bijv. 06 12 34 56 78" data-p-phone></label>
      </div>

      <label class="p-field" style="margin-top:12px"><span>Opmerking over je print</span><textarea style="min-height:96px" placeholder="Bijvoorbeeld: sterk onderdeel, glad uiterlijk, montagegat moet netjes blijven..." data-p-note></textarea></label>

      <button type="submit" class="p-btn p-btn-primary" style="width:100%;margin-top:18px" data-p-submit disabled>Offerte aanvragen</button>
      <div class="p-upload-progress" data-p-upload-progress hidden>
        <div class="p-mini-printer" aria-hidden="true"><span></span><i></i><b></b></div>
        <div class="p-upload-progress-copy">
          <strong data-p-upload-status>Bestanden uploaden...</strong>
          <span data-p-upload-percent>0%</span>
        </div>
        <div class="p-upload-progress-bar"><span data-p-upload-bar style="width:0%"></span></div>
      </div>
      <div class="p-error" data-p-bridge-error>De aanvraag kon niet worden verstuurd. Controleer de koppeling en probeer het opnieuw.</div>
      <p class="p-form-note">Je betaalt pas nadat je de offerte hebt goedgekeurd.</p>
    </div>
  </form>
</div>
