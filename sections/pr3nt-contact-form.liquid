<section class="p-section white" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap p-grid-2 p-align-start" style="gap:28px">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="p-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 class="p-title-sm">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p class="p-copy">{{ section.settings.text }}</p>{% endif %}

      <div style="margin-top:22px" class="p-stack">
        <div class="p-card"><div class="p-card-body"><h3 class="p-card-title">{{ section.settings.info_1_title }}</h3><p class="p-card-text">{{ section.settings.info_1_text }}</p></div></div>
        <div class="p-card"><div class="p-card-body"><h3 class="p-card-title">{{ section.settings.info_2_title }}</h3><p class="p-card-text">{{ section.settings.info_2_text }}</p></div></div>
      </div>
    </div>

    <div style="background:transparent;border:0;box-shadow:none;padding:0;color:var(--p-dark)">
      <form id="Pr3ntContactForm" data-pr3nt-contact-form data-p-contact-endpoint="{{ section.settings.endpoint_url | default: 'https://app.pr3nt.nl/api/contact' }}" novalidate>
        <div class="p-success" data-p-contact-success hidden>
          <strong>{{ section.settings.success_heading }}</strong>
          <p style="margin:8px 0 0;color:rgba(255,255,255,.72)">{{ section.settings.success_text }}</p>
        </div>

        <div class="p-error" data-p-contact-error>
          Controleer de ingevulde velden en probeer het opnieuw.
        </div>

        <div class="p-contact-group">
          <p class="p-contact-group-title">{{ section.settings.form_heading }}</p>

          <label class="p-field">
            <span>Naam</span>
            <input type="text" name="name" autocomplete="name" placeholder="Je naam" required>
          </label>

          <label class="p-field" style="margin-top:14px">
            <span>E-mailadres</span>
            <input type="email" name="email" autocomplete="email" placeholder="jij@example.nl" required>
          </label>

          <label class="p-field" style="margin-top:14px">
            <span>Telefoonnummer <small style="font-weight:700;color:rgba(16,24,32,.45)">(optioneel)</small></span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="Bijv. 06 12 34 56 78">
          </label>

          <label class="p-field" style="margin-top:14px">
            <span>Waar gaat je vraag over?</span>
            <select name="subject" style="width:100%;border:1px solid rgba(16,24,32,.1);background:var(--p-cream);border-radius:14px;padding:13px 14px;outline:none;color:var(--p-dark)">
              <option>Algemene vraag</option>
              <option>Vraag over materiaal</option>
              <option>Vraag over een offerte</option>
              <option>Zakelijke aanvraag</option>
              <option>Vraag over een lopende bestelling</option>
            </select>
          </label>

          <label class="p-field" style="margin-top:14px">
            <span>Bericht</span>
            <textarea name="message" placeholder="Vertel kort waar je vraag over gaat. Bij technische vragen helpt het om toepassing, materiaalwens of maatvoering te noemen." required></textarea>
          </label>

          <button type="submit" class="p-btn p-btn-primary" style="width:100%;margin-top:18px" data-p-contact-submit>{{ section.settings.button_label }}</button>
          <p class="p-form-note">{{ section.settings.form_note }}</p>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function(){
      var form = document.currentScript.closest('section').querySelector('[data-pr3nt-contact-form]');
      if(!form || form.dataset.ready) return;
      form.dataset.ready = 'true';
      form.addEventListener('submit', async function(event){
        event.preventDefault();
        var endpoint = form.getAttribute('data-p-contact-endpoint');
        var submit = form.querySelector('[data-p-contact-submit]');
        var success = form.querySelector('[data-p-contact-success]');
        var error = form.querySelector('[data-p-contact-error]');
        var data = Object.fromEntries(new FormData(form).entries());
        function fail(message){
          if(error){ error.textContent = message || 'Het bericht kon niet worden verstuurd. Probeer het opnieuw.'; error.classList.add('is-visible'); }
          if(success) success.hidden = true;
          if(submit){ submit.disabled = false; submit.textContent = '{{ section.settings.button_label | escape }}'; }
        }
        if(error) error.classList.remove('is-visible');
        if(!data.name || !data.email || !data.message){ fail('Vul je naam, e-mailadres en bericht in.'); return; }
        if(submit){ submit.disabled = true; submit.textContent = 'Bericht versturen...'; }
        try {
          var response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          var json = await response.json().catch(function(){ return {}; });
          if(!response.ok || json.ok === false) throw new Error(json.error || 'Het bericht kon niet worden verstuurd.');
          form.reset();
          if(success) success.hidden = false;
          if(submit){ submit.disabled = false; submit.textContent = '{{ section.settings.button_label | escape }}'; }
        } catch(err) {
          fail(err.message);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "pr3nt contactformulier",
  "settings": [
    {"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":72},
    {"type":"text","id":"endpoint_url","label":"Contact endpoint","default":"https://app.pr3nt.nl/api/contact"},
    {"type":"text","id":"eyebrow","label":"Label","default":"Stuur een bericht"},
    {"type":"text","id":"heading","label":"Titel","default":"Vraag stellen aan pr3nt"},
    {"type":"textarea","id":"text","label":"Tekst","default":"Heb je een algemene vraag, wil je materiaaladvies of gaat het om een lopende aanvraag? Vul het formulier in en we reageren zo snel mogelijk."},
    {"type":"text","id":"info_1_title","label":"Infokaart 1 titel","default":"Voor offertes"},
    {"type":"textarea","id":"info_1_text","label":"Infokaart 1 tekst","default":"Wil je een prijs voor een print? Upload dan liever direct je 3D-bestand via het offerteformulier op de homepage."},
    {"type":"text","id":"info_2_title","label":"Infokaart 2 titel","default":"Voor zakelijke aanvragen"},
    {"type":"textarea","id":"info_2_text","label":"Infokaart 2 tekst","default":"Voor prototypes, kleine series of functionele onderdelen kun je jouw toepassing kort omschrijven. Dan denken we gericht mee."},
    {"type":"text","id":"form_heading","label":"Formulier titel","default":"Contactformulier"},
    {"type":"text","id":"button_label","label":"Knoptekst","default":"Bericht versturen"},
    {"type":"text","id":"form_note","label":"Notitie onder formulier","default":"Voor bestanden gebruik je het offerteformulier. Via dit formulier kun je nog geen 3D-bestanden meesturen."},
    {"type":"text","id":"success_heading","label":"Succes titel","default":"Bedankt voor je bericht."},
    {"type":"textarea","id":"success_text","label":"Succes tekst","default":"We hebben je bericht ontvangen en nemen contact met je op."}
  ],
  "presets": [{"name":"pr3nt contactformulier"}]
}
{% endschema %}
