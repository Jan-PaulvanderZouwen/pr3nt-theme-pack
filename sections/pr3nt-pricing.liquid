<section class="p-section" id="prijzen" style="--py:{{ section.settings.padding_y }}px"><div class="p-wrap"><div class="p-grid-2"><div><p class="p-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="p-title-sm">{{ section.settings.heading }}</h2><p class="p-copy">{{ section.settings.text }}</p></div><div class="p-card" style="padding:22px">{% for block in section.blocks %}{% if block.type == 'price_row' %}<div class="p-price-row" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><strong>{{ block.settings.value }}</strong></div>{% endif %}{% endfor %}</div></div>{% if section.settings.example_heading != blank %}<div class="p-highlight" style="margin-top:28px"><div><h3 style="margin:0;font-size:26px;font-weight:700">{{ section.settings.example_heading }}</h3><p>{{ section.settings.example_text }}</p></div><a href="{{ section.settings.example_button_link }}" class="p-btn p-btn-primary">{{ section.settings.example_button_label }}</a></div>{% endif %}<div class="p-grid-4" style="margin-top:24px">{% for block in section.blocks %}{% if block.type == 'example_card' %}<div class="p-card p-card-body" {{ block.shopify_attributes }}><h3 class="p-card-title">{{ block.settings.title }}</h3><p class="p-card-text">{{ block.settings.text }}</p><strong style="display:block;margin-top:18px;font-size:28px">{{ block.settings.price }}</strong></div>{% endif %}{% endfor %}</div></div></section>
