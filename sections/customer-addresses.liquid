<section class="p-section"><div class="p-wrap"><p class="p-eyebrow">Account</p><h1 class="p-title-sm">Adressen</h1><div class="p-grid-2" style="margin-top:28px">{% for address in customer.addresses %}<div class="p-card p-card-body">{{ address | format_address }}</div>{% endfor %}<div class="p-card p-card-body"><h2 class="p-card-title">Nieuw adres</h2>{% form 'customer_address', customer.new_address %}<label class="p-field"><span>Voornaam</span><input name="address[first_name]"></label><label class="p-field" style="margin-top:12px"><span>Achternaam</span><input name="address[last_name]"></label><label class="p-field" style="margin-top:12px"><span>Adres</span><input name="address[address1]"></label><label class="p-field" style="margin-top:12px"><span>Stad</span><input name="address[city]"></label><button class="p-btn p-btn-primary" style="margin-top:18px">Opslaan</button>{% endform %}</div></div></div></section>
{% schema %}{"name":"Klant adressen","settings":[]}{% endschema %}
