<section class="p-section" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap p-confirm-wrap">
    <div class="p-confirm-card">
      <div class="p-confirm-icon">✓</div>
      <p class="p-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="p-title-sm">{{ section.settings.heading }}</h1>
      <p class="p-copy" style="margin-left:auto;margin-right:auto;">{{ section.settings.text }}</p>

      <div class="p-confirm-steps">
        {% for block in section.blocks %}
          <div class="p-confirm-step" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            {{ block.settings.text }}
          </div>
        {% endfor %}
      </div>

      {% if section.settings.button_label != blank %}
        <div class="p-button-row" style="justify-content:center;">
          <a href="{{ section.settings.button_link }}" class="p-btn p-btn-dark">{{ section.settings.button_label }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "pr3nt offerte bevestigd",
  "settings": [
    { "type": "range", "id": "padding_y", "label": "Verticale ruimte", "min": 40, "max": 140, "step": 4, "default": 76 },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Aanvraag ontvangen" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Bedankt, je offerte-aanvraag is binnen." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "We controleren je 3D-bestand, beoordelen de printbaarheid en sturen je daarna een duidelijke offerte. Je betaalt pas nadat je akkoord hebt gegeven." },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Terug naar homepage" },
    { "type": "url", "id": "button_link", "label": "Knoplink", "default": "/" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Volgende stap",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Stap" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Beschrijving" }
      ]
    }
  ],
  "presets": [
    {
      "name": "pr3nt offerte bevestigd",
      "blocks": [
        { "type": "step", "settings": { "title": "1. Controle", "text": "We openen en slicen je bestand." } },
        { "type": "step", "settings": { "title": "2. Offerte", "text": "Je ontvangt een prijsvoorstel per mail." } },
        { "type": "step", "settings": { "title": "3. Print", "text": "Na akkoord starten we je print." } }
      ]
    }
  ]
}
{% endschema %}
