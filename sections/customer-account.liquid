<section class="p-section"><div class="p-wrap"><p class="p-eyebrow">Account</p><h1 class="p-title-sm">Mijn account</h1><div class="p-button-row"><a class="p-btn p-btn-primary" href="/pages/portal">Naar dashboard</a><a class="p-btn p-btn-outline" href="{{ routes.account_addresses_url }}">Adressen beheren</a><a class="p-btn p-btn-outline" href="{{ routes.account_logout_url }}">Uitloggen</a></div><div class="p-stack" style="margin-top:28px">{% for order in customer.orders %}<div class="p-card p-card-body"><h2 class="p-card-title">{{ order.name }}</h2><p class="p-card-text">{{ order.created_at | date: '%d-%m-%Y' }} · {{ order.total_price | money }} · {{ order.financial_status_label }}</p><a class="p-btn p-btn-outline" href="{{ order.customer_url }}" style="margin-top:12px">Bekijk order</a></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Klant account","settings":[]}{% endschema %}
