<section class="p-section"><div class="p-wrap" style="max-width:560px"><div class="p-card p-card-body"><h1 class="p-title-sm">Nieuw wachtwoord</h1>{% form 'reset_customer_password' %}{{ form.errors | default_errors }}<label class="p-field" style="margin-top:20px"><span>Nieuw wachtwoord</span><input type="password" name="customer[password]" required></label><label class="p-field" style="margin-top:14px"><span>Herhaal wachtwoord</span><input type="password" name="customer[password_confirmation]" required></label><button class="p-btn p-btn-primary" type="submit" style="width:100%;margin-top:18px">Wachtwoord opslaan</button>{% endform %}</div></div></section>
