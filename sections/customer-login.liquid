<section class="p-section"><div class="p-wrap" style="max-width:560px"><div class="p-card p-card-body"><h1 class="p-title-sm">Inloggen</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label class="p-field" style="margin-top:20px"><span>E-mailadres</span><input type="email" name="customer[email]" autocomplete="email" required></label><label class="p-field" style="margin-top:14px"><span>Wachtwoord</span><input type="password" name="customer[password]" autocomplete="current-password" required></label><button class="p-btn p-btn-primary" type="submit" style="width:100%;margin-top:18px">Inloggen</button>{% endform %}<a href="#recover" class="p-btn p-btn-outline" style="width:100%;margin-top:12px">Wachtwoord resetten</a></div><div id="recover" class="p-card p-card-body" style="margin-top:18px"><h2 class="p-card-title">Wachtwoord resetten</h2>{% form 'recover_customer_password' %}{{ form.errors | default_errors }}<label class="p-field" style="margin-top:14px"><span>E-mailadres</span><input type="email" name="email" required></label><button class="p-btn p-btn-dark" type="submit" style="width:100%;margin-top:18px">Resetlink versturen</button>{% endform %}</div></div></section>
{% schema %}{"name":"Klant login","settings":[]}{% endschema %}
