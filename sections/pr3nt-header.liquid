<header class="p-header" data-p-header>
  <div class="p-header-wrap">
    <a href="{{ section.settings.logo_link | default: routes.root_url }}" class="p-logo">
      <span class="p-logo-mark">{{ section.settings.logo_mark }}</span>
      <span>
        <span class="p-logo-title">{{ section.settings.logo_text }}</span>
        <span class="p-logo-subtitle">{{ section.settings.logo_subtitle }}</span>
      </span>
    </a>

    {% if section.settings.menu != blank %}
      <nav class="p-nav" aria-label="Hoofdnavigatie">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="p-header-actions">
      <a href="{{ section.settings.cta_link }}" class="p-btn p-btn-dark p-header-cta">{{ section.settings.cta_label }}</a>
      {% if section.settings.menu != blank %}
        <button type="button" class="p-menu-toggle" data-p-menu-toggle aria-expanded="false" aria-controls="Pr3ntMobileMenu">
          <span class="p-menu-toggle-label">Menu</span>
          <span class="p-menu-icon" aria-hidden="true"><span></span><span></span></span>
        </button>
      {% endif %}
    </div>
  </div>

  {% if section.settings.menu != blank %}
    <div class="p-mobile-menu" id="Pr3ntMobileMenu" data-p-mobile-menu hidden>
      <div class="p-mobile-menu-inner">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
        <a href="{{ section.settings.cta_link }}" class="p-btn p-btn-primary">{{ section.settings.cta_label }}</a>
      </div>
    </div>
  {% endif %}
</header>

{% schema %}
{
  "name": "pr3nt header",
  "settings": [
    {"type":"text","id":"logo_mark","label":"Logo icoon","default":"3"},
    {"type":"text","id":"logo_text","label":"Logo tekst","default":"pr3nt"},
    {"type":"text","id":"logo_subtitle","label":"Logo ondertitel","default":"3D-printservice"},
    {"type":"text","id":"logo_link","label":"Logo link","default":"/"},
    {"type":"link_list","id":"menu","label":"Hoofdmenu","default":"main-menu"},
    {"type":"text","id":"cta_label","label":"CTA tekst","default":"Offerte aanvragen"},
    {"type":"text","id":"cta_link","label":"CTA link","default":"/#upload"}
  ],
  "presets": [
    {"name":"pr3nt header"}
  ]
}
{% endschema %}
