<section class="p-section"><div class="p-wrap" style="max-width:560px"><div class="p-card p-card-body"><h1 class="p-title-sm">Account aanmaken</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label class="p-field" style="margin-top:20px"><span>Voornaam</span><input name="customer[first_name]"></label><label class="p-field" style="margin-top:14px"><span>Achternaam</span><input name="customer[last_name]"></label><label class="p-field" style="margin-top:14px"><span>E-mailadres</span><input type="email" name="customer[email]" required></label><label class="p-field" style="margin-top:14px"><span>Wachtwoord</span><input type="password" name="customer[password]" required></label><button class="p-btn p-btn-primary" type="submit" style="width:100%;margin-top:18px">Account aanmaken</button>{% endform %}</div></div></section>
{% schema %}{"name":"Klant registratie","settings":[]}{% endschema %}
