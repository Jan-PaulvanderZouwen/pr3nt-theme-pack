{{ 'pr3nt.css' | asset_url | stylesheet_tag }}
{{ 'pr3nt-form-polish.css' | asset_url | stylesheet_tag }}

<section
  class="p-section {% if section.settings.background == 'dark' %}dark{% elsif section.settings.background == 'white' %}white{% endif %}{% if section.settings.hide_section %} p-shopify-forms-hidden{% endif %}"
  id="{{ section.settings.anchor_id | escape }}"
  data-pr3nt-shopify-forms-bridge
  style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap p-grid-2">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="p-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 class="p-title-sm">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p class="p-copy">{{ section.settings.text }}</p>{% endif %}

      {% if section.settings.show_form_id_note %}
        <div class="p-card p-card-body" style="margin-top:22px;background:{% if section.settings.background == 'dark' %}rgba(255,255,255,.08){% else %}#fff{% endif %};color:inherit;">
          <p class="p-card-text" style="margin:0;{% if section.settings.background == 'dark' %}color:rgba(255,255,255,.68);{% endif %}">
            Shopify Forms ID: <strong>{{ section.settings.form_id }}</strong><br>
            Voeg in deze sectie een <strong>Forms app block</strong> toe en plak dit ID in het veld Form ID.
          </p>
        </div>
      {% endif %}
    </div>

    <div class="p-form-shell">
      <div class="p-form">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% render block %}
          {% endfor %}
        {% else %}
          <div class="p-confirm-card" style="box-shadow:none;padding:28px;">
            <div class="p-confirm-icon" style="width:62px;height:62px;border-radius:20px;font-size:28px;">+</div>
            <h3 class="p-form-title">Forms app block toevoegen</h3>
            <p class="p-card-text">
              Open de theme customizer, klik op deze sectie en voeg een app block van <strong>Shopify Forms</strong> toe. Gebruik Form ID <strong>{{ section.settings.form_id }}</strong>.
            </p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "pr3nt Shopify Forms",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Sectie verbergen maar technisch actief houden", "default": true },
    { "type": "select", "id": "background", "label": "Achtergrond", "default": "dark", "options": [
      { "value": "cream", "label": "Crème" },
      { "value": "white", "label": "Wit" },
      { "value": "dark", "label": "Donker" }
    ] },
    { "type": "text", "id": "anchor_id", "label": "Anker ID", "default": "shopify-forms-offerte" },
    { "type": "range", "id": "padding_y", "label": "Verticale ruimte", "min": 0, "max": 140, "step": 4, "default": 0 },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Offerte aanvragen" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Upload je bestand via Shopify Forms." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Gebruik deze sectie als je de inzendingen, uploads en bevestigingen via Shopify Forms wilt laten lopen, maar wel binnen de pr3nt uitstraling wilt blijven." },
    { "type": "text", "id": "form_id", "label": "Shopify Forms Form ID", "default": "970579" },
    { "type": "checkbox", "id": "show_form_id_note", "label": "Toon Form ID instructie", "default": false }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "pr3nt Shopify Forms" }
  ]
}
{% endschema %}
