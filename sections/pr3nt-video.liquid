<section class="p-section" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap p-grid-2">
    <div class="p-video-frame" style="min-height:{{ section.settings.video_height }}px;">
      {% if section.settings.video_embed_url != blank %}
        <iframe
          src="{{ section.settings.video_embed_url }}"
          title="{{ section.settings.heading | escape }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy">
        </iframe>
      {% elsif section.settings.video_file_url != blank %}
        <video controls playsinline preload="metadata" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% endif %}>
          <source src="{{ section.settings.video_file_url }}" type="video/mp4">
          Je browser ondersteunt deze video niet.
        </video>
      {% elsif section.settings.poster != blank %}
        <div class="p-media" style="min-height:{{ section.settings.video_height }}px;">
          <img src="{{ section.settings.poster | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        </div>
      {% else %}
        <div class="p-media-fallback">Vul een embed URL of MP4 video-URL in</div>
      {% endif %}
    </div>

    <div>
      <p class="p-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="p-title-sm">{{ section.settings.heading }}</h2>
      <p class="p-copy">{{ section.settings.text }}</p>
      <div style="display:grid;gap:10px;margin-top:20px;font-weight:700;color:rgba(16,24,32,.68)">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}><span class="p-dot"></span>{{ block.settings.text }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "pr3nt video",
  "settings": [
    { "type": "range", "id": "padding_y", "label": "Verticale ruimte", "min": 40, "max": 140, "step": 4, "default": 76 },
    { "type": "image_picker", "id": "poster", "label": "Video thumbnail / poster" },
    { "type": "text", "id": "video_embed_url", "label": "Embed URL", "info": "Gebruik bijvoorbeeld een YouTube embed URL zoals https://www.youtube.com/embed/VIDEO_ID of een Vimeo embed URL." },
    { "type": "text", "id": "video_file_url", "label": "MP4 video URL", "info": "Upload een MP4 naar Shopify Files en plak hier de bestands-URL." },
    { "type": "range", "id": "video_height", "label": "Video hoogte", "min": 240, "max": 520, "step": 20, "default": 360 },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Bekijk hoe het werkt" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "In 1 minuut zie je hoe uploaden, beoordelen en printen werkt." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Plaats hier een korte video van je P1S, het uploadproces en een afgeronde print. Dat maakt de service direct begrijpelijk en betrouwbaar." }
  ],
  "blocks": [
    { "type": "bullet", "name": "Bullet", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Bullet" } ] }
  ],
  "presets": [
    {
      "name": "pr3nt video",
      "blocks": [
        { "type": "bullet", "settings": { "text": "Upload je 3D-bestand" } },
        { "type": "bullet", "settings": { "text": "Wij beoordelen en slicen" } },
        { "type": "bullet", "settings": { "text": "Jij ontvangt de offerte" } },
        { "type": "bullet", "settings": { "text": "Akkoord? Wij printen en verzenden" } }
      ]
    }
  ]
}
{% endschema %}
