<section class="p-section" style="--py:{{ section.settings.padding_y }}px"><div class="p-wrap p-grid-2"><div class="p-media" style="min-height:{{ section.settings.video_height }}px;border-radius:var(--p-radius);box-shadow:var(--p-shadow)">{% if section.settings.poster != blank %}<img src="{{ section.settings.poster | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">{% else %}<div class="p-media-fallback">Upload video-thumbnail</div>{% endif %}{% if section.settings.video_url != blank %}<a href="{{ section.settings.video_url }}" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:92px;height:92px;border-radius:999px;background:rgba(255,255,255,.92);display:grid;place-items:center;font-size:32px;box-shadow:0 18px 44px rgba(0,0,0,.25)" aria-label="Bekijk video">▶</a>{% endif %}</div><div><p class="p-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="p-title-sm">{{ section.settings.heading }}</h2><p class="p-copy">{{ section.settings.text }}</p><div style="display:grid;gap:10px;margin-top:20px;font-weight:850;color:rgba(16,24,32,.68)">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="p-dot"></span>{{ block.settings.text }}</div>{% endfor %}</div></div></div></section>
{% schema %}{"name":"pr3nt video","settings":[{"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":76},{"type":"image_picker","id":"poster","label":"Video thumbnail"},{"type":"text","id":"video_url","label":"Video URL"},{"type":"range","id":"video_height","label":"Video hoogte","min":240,"max":520,"step":20,"default":360},{"type":"text","id":"eyebrow","label":"Label","default":"Bekijk hoe het werkt"},{"type":"text","id":"heading","label":"Titel","default":"In 1 minuut zie je hoe uploaden, beoordelen en printen werkt."},{"type":"textarea","id":"text","label":"Tekst","default":"Plaats hier een korte video van je P1S, het uploadproces en een afgeronde print. Dat maakt de service direct begrijpelijk en betrouwbaar."}],"blocks":[{"type":"bullet","name":"Bullet","settings":[{"type":"text","id":"text","label":"Tekst","default":"Bullet"}]}],"presets":[{"name":"pr3nt video","blocks":[{"type":"bullet","settings":{"text":"Upload je 3D-bestand"}},{"type":"bullet","settings":{"text":"Wij beoordelen en slicen"}},{"type":"bullet","settings":{"text":"Jij ontvangt de offerte"}},{"type":"bullet","settings":{"text":"Akkoord? Wij printen en verzenden"}}]}]}{% endschema %}
