<section class="p-section white" id="faq" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap p-grid-2 p-align-start">
    <div style="text-align:left;">
      <p class="p-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="p-title-sm">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p class="p-copy">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div>
      {% for block in section.blocks %}
        <details class="p-card" style="padding:18px 20px;margin-bottom:12px" {{ block.shopify_attributes }}>
          <summary style="cursor:pointer;font-weight:800;line-height:1.35;">{{ block.settings.question }}</summary>
          <p class="p-card-text">{{ block.settings.answer }}</p>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "pr3nt FAQ",
  "settings": [
    { "type": "range", "id": "padding_y", "label": "Verticale ruimte", "min": 40, "max": 140, "step": 4, "default": 76 },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Veelgestelde vragen." },
    { "type": "textarea", "id": "text", "label": "Ondertekst", "default": "Alles wat je wilt weten voordat je jouw 3D-bestand uploadt." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag", "default": "Vraag" },
        { "type": "textarea", "id": "answer", "label": "Antwoord", "default": "Antwoord" }
      ]
    }
  ],
  "presets": [
    {
      "name": "pr3nt FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Waarom niet direct afrekenen?", "answer": "Een 3D-bestand moet eerst gecontroleerd en gesliced worden. Gewicht, printtijd, support en printoriëntatie bepalen de echte prijs." } },
        { "type": "faq", "settings": { "question": "Welke bestanden kan ik uploaden?", "answer": "Je kunt STL, 3MF, OBJ, STEP of STP uploaden. Wij controleren daarna of het model geschikt is om te printen." } },
        { "type": "faq", "settings": { "question": "Hoe snel wordt mijn print verzonden?", "answer": "Standaard verzenden we binnen 3 dagen na akkoord. Kies je voor spoed, dan verzenden we binnen 2 dagen na akkoord." } },
        { "type": "faq", "settings": { "question": "Zijn alle kleuren echt mogelijk?", "answer": "Ja, je kunt een gewenste kleur invullen. De exacte tint is afhankelijk van leverbaarheid van filament." } }
      ]
    }
  ]
}
{% endschema %}
