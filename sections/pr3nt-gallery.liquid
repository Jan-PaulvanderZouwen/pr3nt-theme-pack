<section class="p-section {% if section.settings.background == 'white' %}white{% endif %}" id="inspiratie" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap">
    <div class="p-grid-2">
      <div>
        <p class="p-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="p-title-sm">{{ section.settings.heading }}</h2>
      </div>
      <p class="p-copy">{{ section.settings.text }}</p>
    </div>

    <div class="p-grid-3" style="margin-top:34px">
      {% for block in section.blocks %}
        {% assign p_gallery_title = block.settings.title | strip %}
        {% assign p_gallery_url = '/pages/werkplaats' %}
        {% assign p_gallery_badge = 'Functioneel' %}
        {% assign p_gallery_text = 'Voor praktische onderdelen die je snel wilt gebruiken in plaats van eindeloos zoeken naar een standaardoplossing.' %}

        {% case p_gallery_title %}
          {% when 'Werkplaats' %}
            {% assign p_gallery_url = '/pages/werkplaats' %}
            {% assign p_gallery_badge = 'Slimme hulpstukken' %}
            {% assign p_gallery_text = 'Denk aan gereedschapshouders, mallen, clips, adapters en onderdelen die precies passen bij jouw werkplek.' %}
          {% when 'Woonaccessoires' %}
            {% assign p_gallery_url = '/pages/woonaccessoires' %}
            {% assign p_gallery_badge = 'Persoonlijk interieur' %}
            {% assign p_gallery_text = 'Maak unieke vazen, wandhaakjes, plantenhouders of kleine accessoires die je niet standaard in de winkel ziet.' %}
          {% when 'Bureau-accessoires' %}
            {% assign p_gallery_url = '/pages/bureau-accessoires' %}
            {% assign p_gallery_badge = 'Strakker bureau' %}
            {% assign p_gallery_text = 'Van kabelgeleiders tot laptopsteunen en kleine organisers: handig voor een nette werkplek.' %}
          {% when 'Opbergers' %}
            {% assign p_gallery_url = '/pages/opbergers' %}
            {% assign p_gallery_badge = 'Netjes op maat' %}
            {% assign p_gallery_text = 'Opbergers zijn ideaal als standaard bakjes net niet passen. Denk aan lades, vakverdelers en houders.' %}
          {% when 'Gaming' %}
            {% assign p_gallery_url = '/pages/gaming' %}
            {% assign p_gallery_badge = 'Setup upgrade' %}
            {% assign p_gallery_text = 'Print stands, mounts, controllerhouders, desk-accessoires of onderdelen voor je sim-rig en setup.' %}
          {% when 'Modelbouw' %}
            {% assign p_gallery_url = '/pages/modelbouw' %}
            {% assign p_gallery_badge = 'Details en hobby' %}
            {% assign p_gallery_text = 'Voor terrain, onderdelen, hulpstukken en prototypes waarmee je hobbyproject sneller verder kan.' %}
        {% endcase %}

        {% if block.settings.linked_page != blank %}
          {% assign p_gallery_url = block.settings.linked_page.url %}
        {% endif %}

        <a class="p-card p-gallery-card" href="{{ p_gallery_url }}" {{ block.shopify_attributes }}>
          <span class="p-gallery-badge">{{ p_gallery_badge }}</span>
          <div class="p-media">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }} laten 3D-printen" loading="lazy">
            {% else %}
              <div class="p-media-fallback">Upload afbeelding</div>
            {% endif %}
          </div>
          <div class="p-card-body">
            <h3 class="p-card-title">{{ block.settings.title }}</h3>
            <p class="p-gallery-text">{{ p_gallery_text }}</p>
            <span class="p-gallery-link">Bekijk voorbeelden en toepassingen</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "pr3nt gallery",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Achtergrond",
      "default": "white",
      "options": [
        {
          "value": "cream",
          "label": "Crème"
        },
        {
          "value": "white",
          "label": "Wit"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Verticale ruimte",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 76
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Voorbeelden"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Bekijk voorbeelden uit het echte leven."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Vervang deze afbeeldingen door je eigen prints of door afbeeldingen waarvoor je toestemming hebt."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Afbeelding",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Voorbeeld"
        },
        {
          "type": "page",
          "id": "linked_page",
          "label": "Link naar pagina",
          "info": "Kies hier de pagina waar deze kaart naartoe moet linken. Als je niets kiest, gebruikt de kaart de automatische fallback op basis van de titel."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "pr3nt gallery",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "title": "Functioneel onderdeel"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Kabelclip"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Plantenaccessoire"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Tabletop terrain"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Prototype behuizing"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Tandwiel"
          }
        }
      ]
    }
  ]
}
{% endschema %}
