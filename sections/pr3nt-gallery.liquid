<section class="p-section {% if section.settings.background == 'white' %}white{% endif %}" id="inspiratie" style="--py:{{ section.settings.padding_y }}px"><div class="p-wrap"><div class="p-grid-2"><div><p class="p-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="p-title-sm">{{ section.settings.heading }}</h2></div><p class="p-copy">{{ section.settings.text }}</p></div><div class="p-grid-3" style="margin-top:34px">{% for block in section.blocks %}<article class="p-card" {{ block.shopify_attributes }}><div class="p-media">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% else %}<div class="p-media-fallback">Upload afbeelding</div>{% endif %}</div><div class="p-card-body"><h3 class="p-card-title">{{ block.settings.title }}</h3></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"pr3nt gallery","settings":[{"type":"select","id":"background","label":"Achtergrond","default":"white","options":[{"value":"cream","label":"Crème"},{"value":"white","label":"Wit"}]},{"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":76},{"type":"text","id":"eyebrow","label":"Label","default":"Voorbeelden"},{"type":"text","id":"heading","label":"Titel","default":"Bekijk voorbeelden uit het echte leven."},{"type":"textarea","id":"text","label":"Tekst","default":"Vervang deze afbeeldingen door je eigen prints of door afbeeldingen waarvoor je toestemming hebt."}],"blocks":[{"type":"image","name":"Afbeelding","settings":[{"type":"image_picker","id":"image","label":"Afbeelding"},{"type":"text","id":"title","label":"Titel","default":"Voorbeeld"}]}],"presets":[{"name":"pr3nt gallery","blocks":[{"type":"image","settings":{"title":"Functioneel onderdeel"}},{"type":"image","settings":{"title":"Kabelclip"}},{"type":"image","settings":{"title":"Plantenaccessoire"}},{"type":"image","settings":{"title":"Tabletop terrain"}},{"type":"image","settings":{"title":"Prototype behuizing"}},{"type":"image","settings":{"title":"Tandwiel"}}]}]}{% endschema %}
