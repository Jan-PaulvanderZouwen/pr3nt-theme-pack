<section class="p-section {% if section.settings.background == 'white' %}white{% endif %}" style="--py:{{ section.settings.padding_y }}px"><div class="p-wrap"><div class="p-grid-2"><div><p class="p-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="p-title-sm">{{ section.settings.heading }}</h2></div><p class="p-copy">{{ section.settings.text }}</p></div><div class="p-grid-4" style="margin-top:34px">{% for block in section.blocks %}<article class="p-card" {{ block.shopify_attributes }}><div class="p-media">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% else %}<div class="p-media-fallback">Upload afbeelding</div>{% endif %}</div><div class="p-card-body"><h3 class="p-card-title">{{ block.settings.title }}</h3><p class="p-card-text">{{ block.settings.text }}</p></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"pr3nt feature cards","settings":[{"type":"select","id":"background","label":"Achtergrond","default":"white","options":[{"value":"cream","label":"Crème"},{"value":"white","label":"Wit"}]},{"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":76},{"type":"text","id":"eyebrow","label":"Label","default":"Waarom pr3nt.nl?"},{"type":"text","id":"heading","label":"Titel","default":"Laat ideeën tastbaar worden met echte voorbeelden."},{"type":"textarea","id":"text","label":"Tekst","default":"Gebruik hier eigen foto’s of goedgekeurde afbeeldingen van modellen en prints, zodat bezoekers direct inspiratie krijgen."}],"blocks":[{"type":"card","name":"Kaart","settings":[{"type":"image_picker","id":"image","label":"Afbeelding"},{"type":"text","id":"title","label":"Titel","default":"Titel"},{"type":"textarea","id":"text","label":"Tekst","default":"Beschrijving"}]}],"presets":[{"name":"pr3nt feature cards","blocks":[{"type":"card","settings":{"title":"Vervang het, niet het geheel","text":"Bespaar tijd en geld met een nieuw onderdeel in plaats van een complete vervanging."}},{"type":"card","settings":{"title":"Voor gamers & hobbyisten","text":"Van terrain tot tokens en accessoires. Breng je game of hobbyproject tot leven."}},{"type":"card","settings":{"title":"Organiseren & verbeteren","text":"Slimme oplossingen voor je werkplek, kabels, tools en onderdelen."}},{"type":"card","settings":{"title":"Jouw idee, onze print","text":"Van prototype tot eindproduct. Wij printen wat jij bedenkt."}}]}]}{% endschema %}
