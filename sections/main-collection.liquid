<section class="p-section"><div class="p-wrap"><p class="p-eyebrow">Collectie</p><h1 class="p-title-sm">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="p-copy">{{ collection.description }}</div>{% endif %}<div class="p-grid-3" style="margin-top:34px">{% for product in collection.products %}<article class="p-card"><a href="{{ product.url }}"><div class="p-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}">{% else %}<div class="p-media-fallback">Product</div>{% endif %}</div><div class="p-card-body"><h2 class="p-card-title">{{ product.title }}</h2><p class="p-card-text">{{ product.price | money }}</p></div></a></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Collectie","settings":[]}{% endschema %}
