{{ 'pr3nt-above-fold.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pr3nt-header-scroll.js' | asset_url }}" defer></script>

{% assign primary_href = section.settings.primary_link %}
{% if primary_href == '#upload' or primary_href == blank %}
  {% assign primary_href = '#offerte-formulier' %}
{% endif %}

<section id="top" class="p-section dark p-hero" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-hero-glow p-hero-glow-left"></div>
  <div class="p-hero-glow p-hero-glow-right"></div>

  <div class="p-wrap p-grid-2 p-hero-grid">
    <div class="p-hero-copy-block">
      {% if section.settings.kicker != blank %}
        <div class="p-hero-kicker">{{ section.settings.kicker }}</div>
      {% endif %}

      <h1 class="p-title p-hero-title">
        {{ section.settings.heading_before }} <span>{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_after }}
      </h1>

      <p class="p-copy">{{ section.settings.text }}</p>

      <div class="p-button-row">
        <a href="{{ primary_href }}" class="p-btn p-btn-primary">{{ section.settings.primary_label }}</a>
        <a href="{{ section.settings.secondary_link }}" class="p-btn p-btn-ghost">{{ section.settings.secondary_label }}</a>
      </div>
    </div>

    {% if section.settings.show_form %}
      <div class="p-form-shell p-hero-form-shell" id="offerte-formulier" data-pr3nt-quote-target>
        {% render 'pr3nt-quote-form', supported_formats: section.settings.supported_formats, form_id: 'Pr3ntHeroQuoteForm', quote_endpoint_url: section.settings.quote_endpoint_url, payment_link_5: section.settings.payment_link_5, payment_link_10: section.settings.payment_link_10, payment_link_15: section.settings.payment_link_15, payment_link_20: section.settings.payment_link_20, payment_link_255: section.settings.payment_link_255 %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "pr3nt hero",
  "settings": [
    {"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":72},
    {"type":"text","id":"kicker","label":"Kleine tekst boven titel","default":"✦ Voor hobbyisten, makers en onderdelen"},
    {"type":"text","id":"heading_before","label":"Titel voor highlight","default":"Upload je 3D-bestand."},
    {"type":"text","id":"heading_highlight","label":"Titel highlight","default":"Ontvang snel"},
    {"type":"text","id":"heading_after","label":"Titel na highlight","default":"je offerte."},
    {"type":"textarea","id":"text","label":"Tekst","default":"Geen eigen 3D-printer? Upload je bestand als STL, 3MF, OBJ, STEP of STP, kies PLA of PETG en vraag eenvoudig een offerte aan. Wij controleren je model en sturen een heldere prijs op basis van materiaal en printtijd."},
    {"type":"text","id":"supported_formats","label":"Ondersteunde formaten","default":"STL, 3MF, OBJ, STEP of STP"},
    {"type":"text","id":"quote_endpoint_url","label":"Offerte-app endpoint URL","info":"Plak hier dezelfde endpoint URL als bij het offerteblok, bijvoorbeeld https://app.pr3nt.nl/api/quote"},
    {"type":"header","content":"Rabobank betaallinks"},
    {"type":"url","id":"payment_link_5","label":"Betaallink 5 × 5 cm"},
    {"type":"url","id":"payment_link_10","label":"Betaallink 10 × 10 cm"},
    {"type":"url","id":"payment_link_15","label":"Betaallink 15 × 15 cm"},
    {"type":"url","id":"payment_link_20","label":"Betaallink 20 × 20 cm"},
    {"type":"url","id":"payment_link_255","label":"Betaallink 25,5 × 25,5 cm"},
    {"type":"text","id":"primary_label","label":"Primaire knop tekst","default":"Vraag offerte aan"},
    {"type":"text","id":"primary_link","label":"Primaire knop link","default":"#offerte-formulier"},
    {"type":"text","id":"secondary_label","label":"Secundaire knop tekst","default":"Bekijk prijsopbouw"},
    {"type":"text","id":"secondary_link","label":"Secundaire knop link","default":"#prijzen"},
    {"type":"checkbox","id":"show_form","label":"Toon offerteformulier","default":true}
  ],
  "blocks": [
    {"type":"badge","name":"Badge","settings":[{"type":"text","id":"label","label":"Label","default":"Label"},{"type":"text","id":"value","label":"Waarde","default":"Waarde"}]}
  ],
  "presets": [
    {"name":"pr3nt hero","blocks":[{"type":"badge","settings":{"label":"Materiaal","value":"PLA & PETG"}},{"type":"badge","settings":{"label":"Formaat","value":"255 × 255 × 255 mm"}},{"type":"badge","settings":{"label":"Standaard","value":"3 dagen verzending"}},{"type":"badge","settings":{"label":"Spoed","value":"2 dagen verzending"}}]}
  ]
}
{% endschema %}