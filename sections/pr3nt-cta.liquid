<section class="p-section" style="--py:{{ section.settings.padding_y }}px"><div class="p-wrap"><div class="p-highlight"><div><p class="p-eyebrow" style="color:var(--p-green)">{{ section.settings.eyebrow }}</p><h2 class="p-title-sm">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><a href="{{ section.settings.button_link }}" class="p-btn p-btn-primary">{{ section.settings.button_label }}</a></div></div></section>
{% schema %}{"name":"pr3nt CTA","settings":[{"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":76},{"type":"text","id":"eyebrow","label":"Label","default":"Klaar om te printen?"},{"type":"text","id":"heading","label":"Titel","default":"Upload je 3D-bestand en ontvang een duidelijke offerte."},{"type":"textarea","id":"text","label":"Tekst","default":"Ideaal voor hobbyisten, makers, modelbouwers en iedereen die snel een onderdeel nodig heeft zonder zelf een printer te kopen."},{"type":"text","id":"button_label","label":"Knoptekst","default":"Offerte aanvragen"},{"type":"text","id":"button_link","label":"Knoplink","default":"#upload"}],"presets":[{"name":"pr3nt CTA"}]}{% endschema %}
