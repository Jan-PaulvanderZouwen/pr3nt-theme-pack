<section class="p-section white" style="padding:0;border-bottom:1px solid rgba(16,24,32,.1)"><div class="p-wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;padding:18px 0;font-weight:850;color:rgba(16,24,32,.68);font-size:14px">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="p-dot"></span>{{ block.settings.text }}</div>{% endfor %}</div></section>
{% schema %}{"name":"pr3nt trustbar","blocks":[{"type":"item","name":"Trust item","settings":[{"type":"text","id":"text","label":"Tekst","default":"Trust item"}]}],"presets":[{"name":"pr3nt trustbar","blocks":[{"type":"item","settings":{"text":"Standaard nabewerking"}},{"type":"item","settings":{"text":"Max. 255 × 255 × 255 mm"}},{"type":"item","settings":{"text":"Alle kleuren mogelijk"}},{"type":"item","settings":{"text":"Verzending in 3 dagen"}},{"type":"item","settings":{"text":"Spoed in 2 dagen"}}]}]}{% endschema %}
