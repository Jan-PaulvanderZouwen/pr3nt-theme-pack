<section class="p-section"><div class="p-wrap"><p class="p-eyebrow">Blog</p><h1 class="p-title-sm">{{ blog.title }}</h1><div class="p-grid-3" style="margin-top:34px">{% for article in blog.articles %}<article class="p-card"><a href="{{ article.url }}"><div class="p-media">{% if article.image %}<img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | escape }}">{% else %}<div class="p-media-fallback">pr3nt blog</div>{% endif %}</div><div class="p-card-body"><p class="p-eyebrow" style="margin-bottom:8px">{{ article.published_at | date: '%d-%m-%Y' }}</p><h2 class="p-card-title">{{ article.title }}</h2><p class="p-card-text">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p></div></a></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Blog overzicht","settings":[]}{% endschema %}
