<section class="p-section"><div class="p-wrap"><p class="p-eyebrow">Order</p><h1 class="p-title-sm">{{ order.name }}</h1><p class="p-copy">{{ order.created_at | date: '%d-%m-%Y' }} · {{ order.total_price | money }}</p>{% assign status = order.metafields.pr3nt.status | default: 'Order ontvangen met orderdetails' %}<div class="p-portal-grid" style="margin-top:28px"><div class="p-card p-card-body"><h2 class="p-card-title">Orderdetails</h2>{% for line_item in order.line_items %}<div class="p-price-row"><span>{{ line_item.title }} × {{ line_item.quantity }}</span><strong>{{ line_item.final_line_price | money }}</strong></div>{% endfor %}</div><div>{% render 'pr3nt-status-timeline', current_status: status %}</div></div></div></section>
{% schema %}{"name":"Klant order","settings":[]}{% endschema %}
