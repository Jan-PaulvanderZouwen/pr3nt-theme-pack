<section class="p-section white"><div class="p-wrap p-grid-2"><div class="p-card"><div class="p-media" style="min-height:420px">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}">{% else %}<div class="p-media-fallback">Productafbeelding</div>{% endif %}</div></div><div><p class="p-eyebrow">Product</p><h1 class="p-title-sm">{{ product.title }}</h1><p class="p-copy">{{ product.description }}</p><div style="font-size:28px;font-weight:900;margin-top:20px">{{ product.selected_or_first_available_variant.price | money }}</div>{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><label class="p-field" style="margin-top:20px"><span>Aantal</span><input type="number" name="quantity" value="1" min="1"></label><button class="p-btn p-btn-primary" type="submit" style="margin-top:16px;width:100%">Toevoegen aan winkelmandje</button>{% endform %}</div></div></section>
{% schema %}{"name":"Productpagina","settings":[]}{% endschema %}
