<section class="p-section" id="portal"><div class="p-wrap"><p class="p-eyebrow">Klantportaal</p><h1 class="p-title-sm">Mijn pr3nt dashboard</h1>{% if customer %}<p class="p-copy">Welkom, {{ customer.first_name | default: customer.email }}. Hier zie je je orders, offertes en printstatus.</p><div class="p-button-row"><a class="p-btn p-btn-primary" href="#upload">Nieuwe offerte aanvragen</a><a class="p-btn p-btn-outline" href="{{ routes.account_addresses_url }}">Accountgegevens beheren</a><a class="p-btn p-btn-outline" href="{{ routes.account_logout_url }}">Uitloggen</a></div>{% if customer.orders.size > 0 %}<div class="p-stack" style="margin-top:28px">{% for order in customer.orders %}{% assign status = order.metafields.pr3nt.status | default: 'Order ontvangen met orderdetails' %}<article class="p-card p-card-body"><div class="p-portal-grid"><div><h2 class="p-card-title">Order {{ order.name }}</h2><p class="p-card-text">Datum: {{ order.created_at | date: '%d-%m-%Y' }} · Totaal: {{ order.total_price | money }}</p><div class="p-button-row">{% if order.metafields.pr3nt.quote_url != blank %}<a class="p-btn p-btn-primary" href="{{ order.metafields.pr3nt.quote_url }}">Offerte inzien/accepteren</a>{% endif %}{% if order.metafields.pr3nt.invoice_url != blank %}<a class="p-btn p-btn-outline" href="{{ order.metafields.pr3nt.invoice_url }}">Factuur bekijken</a>{% endif %}</div>{% if order.metafields.pr3nt.model_url != blank %}<div style="margin-top:20px"><p class="p-eyebrow">3D model</p><model-viewer src="{{ order.metafields.pr3nt.model_url }}" camera-controls auto-rotate style="width:100%;height:320px;background:#fff;border-radius:24px"></model-viewer></div>{% endif %}</div><div>{% render 'pr3nt-status-timeline', current_status: status %}</div></div></article>{% endfor %}</div>{% else %}<div class="p-card p-card-body" style="margin-top:28px"><h2 class="p-card-title">Nog geen orders</h2><p class="p-card-text">Vraag je eerste offerte aan om je order hier te volgen.</p></div>{% endif %}{% else %}<div class="p-card p-card-body" style="margin-top:28px"><h2 class="p-card-title">Log in om je dashboard te bekijken</h2><p class="p-card-text">Na je offerteaanvraag kan je via je account de status volgen.</p><a class="p-btn p-btn-primary" href="{{ routes.account_login_url }}" style="margin-top:16px">Inloggen</a></div>{% endif %}</div></section>
<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
{% schema %}{"name":"pr3nt klantdashboard","settings":[],"presets":[{"name":"pr3nt klantdashboard"}]}{% endschema %}
