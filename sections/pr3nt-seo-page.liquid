<section class="p-section{% if section.settings.dark_hero %} dark{% else %} white{% endif %}" style="--py:{{ section.settings.padding_y }}px">
  <div class="p-wrap">
    {% if section.settings.eyebrow != blank %}<p class="p-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="p-title">{{ section.settings.heading }}</h1>
    {% if section.settings.intro != blank %}<p class="p-copy" style="max-width:780px">{{ section.settings.intro }}</p>{% endif %}
    {% if section.settings.cta_label != blank %}
      <div class="p-button-row"><a href="{{ section.settings.cta_link }}" class="p-btn p-btn-primary">{{ section.settings.cta_label }}</a></div>
    {% endif %}
  </div>
</section>

<section class="p-section white" style="--py:{{ section.settings.content_padding_y }}px">
  <div class="p-wrap p-stack">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'text_block' %}
          <article class="p-card" {{ block.shopify_attributes }}>
            <div class="p-card-body">
              <h2 class="p-title-sm">{{ block.settings.heading }}</h2>
              <div class="p-card-text" style="font-size:16px;max-width:900px">{{ block.settings.text }}</div>
            </div>
          </article>
        {% when 'highlight' %}
          <div class="p-highlight" {{ block.shopify_attributes }}>
            <div>
              <h2 class="p-title-sm" style="margin:0;color:#fff">{{ block.settings.heading }}</h2>
              <p style="margin:12px 0 0">{{ block.settings.text }}</p>
            </div>
            {% if block.settings.button_label != blank %}<a class="p-btn p-btn-primary" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}
          </div>
        {% when 'cards' %}
          <div {{ block.shopify_attributes }}>
            <h2 class="p-title-sm">{{ block.settings.heading }}</h2>
            {% if block.settings.text != blank %}<p class="p-copy">{{ block.settings.text }}</p>{% endif %}
            <div class="p-grid-3" style="margin-top:22px">
              <div class="p-card"><div class="p-card-body"><h3 class="p-card-title">{{ block.settings.card_1_title }}</h3><p class="p-card-text">{{ block.settings.card_1_text }}</p></div></div>
              <div class="p-card"><div class="p-card-body"><h3 class="p-card-title">{{ block.settings.card_2_title }}</h3><p class="p-card-text">{{ block.settings.card_2_text }}</p></div></div>
              <div class="p-card"><div class="p-card-body"><h3 class="p-card-title">{{ block.settings.card_3_title }}</h3><p class="p-card-text">{{ block.settings.card_3_text }}</p></div></div>
            </div>
          </div>
        {% when 'faq' %}
          <article class="p-card" {{ block.shopify_attributes }}>
            <div class="p-card-body">
              <h2 class="p-title-sm">{{ block.settings.question }}</h2>
              <div class="p-card-text" style="font-size:16px">{{ block.settings.answer }}</div>
            </div>
          </article>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "pr3nt SEO pagina",
  "settings": [
    {"type":"checkbox","id":"dark_hero","label":"Donkere hero","default":true},
    {"type":"range","id":"padding_y","label":"Hero verticale ruimte","min":40,"max":140,"step":4,"default":76},
    {"type":"range","id":"content_padding_y","label":"Content verticale ruimte","min":40,"max":140,"step":4,"default":72},
    {"type":"text","id":"eyebrow","label":"Label","default":"3D printservice"},
    {"type":"text","id":"heading","label":"Titel","default":"3D printen laten doen"},
    {"type":"textarea","id":"intro","label":"Intro","default":"Laat jouw 3D-bestand professioneel printen in PLA of PETG. Pr3nt helpt hobbyisten, makers en bedrijven met duidelijke offertes, nette prints en persoonlijke controle van ieder model."},
    {"type":"text","id":"cta_label","label":"CTA tekst","default":"Offerte aanvragen"},
    {"type":"text","id":"cta_link","label":"CTA link","default":"/#upload"}
  ],
  "blocks": [
    {"type":"text_block","name":"Tekstblok","settings":[{"type":"text","id":"heading","label":"Titel","default":"Titel"},{"type":"richtext","id":"text","label":"Tekst","default":"<p>Schrijf hier de tekst voor deze pagina.</p>"}]},
    {"type":"highlight","name":"Uitgelicht blok","settings":[{"type":"text","id":"heading","label":"Titel","default":"Klaar om je bestand te uploaden?"},{"type":"textarea","id":"text","label":"Tekst","default":"Vraag vrijblijvend een offerte aan. We controleren je bestand en sturen een duidelijke prijs voordat je betaalt."},{"type":"text","id":"button_label","label":"Knoptekst","default":"Offerte aanvragen"},{"type":"text","id":"button_link","label":"Knoplink","default":"/#upload"}]},
    {"type":"cards","name":"Drie kaarten","settings":[{"type":"text","id":"heading","label":"Titel","default":"Voor wie is dit geschikt?"},{"type":"textarea","id":"text","label":"Intro","default":"Pr3nt is er voor kleine en praktische 3D-printopdrachten."},{"type":"text","id":"card_1_title","label":"Kaart 1 titel","default":"Hobbyisten"},{"type":"textarea","id":"card_1_text","label":"Kaart 1 tekst","default":"Voor modelbouw, accessoires, reparaties en creatieve projecten."},{"type":"text","id":"card_2_title","label":"Kaart 2 titel","default":"Makers"},{"type":"textarea","id":"card_2_text","label":"Kaart 2 tekst","default":"Voor prototypes, hulpstukken en onderdelen die je snel fysiek wilt testen."},{"type":"text","id":"card_3_title","label":"Kaart 3 titel","default":"Professionals"},{"type":"textarea","id":"card_3_text","label":"Kaart 3 tekst","default":"Voor functionele onderdelen, kleine series en praktische oplossingen op maat."}]},
    {"type":"faq","name":"FAQ blok","settings":[{"type":"text","id":"question","label":"Vraag","default":"Veelgestelde vraag"},{"type":"richtext","id":"answer","label":"Antwoord","default":"<p>Geef hier een duidelijk antwoord.</p>"}]}
  ],
  "presets": [{"name":"pr3nt SEO pagina"}]
}
{% endschema %}
