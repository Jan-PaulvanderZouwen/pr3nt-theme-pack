<section class="p-section" id="hoe" style="--py:{{ section.settings.padding_y }}px"><div class="p-wrap"><p class="p-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="p-title-sm">{{ section.settings.heading }}</h2><div class="p-grid-4" style="margin-top:34px">{% for block in section.blocks %}<div class="p-card p-card-body" {{ block.shopify_attributes }}><div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px"><div class="p-iconbox">{{ forloop.index }}</div><div style="font-size:48px;line-height:1;color:rgba(16,24,32,.1);font-weight:950">{{ forloop.index }}</div></div><h3 class="p-card-title">{{ block.settings.title }}</h3><p class="p-card-text">{{ block.settings.text }}</p></div>{% endfor %}</div></div></section>
{% schema %}{"name":"pr3nt stappen","settings":[{"type":"range","id":"padding_y","label":"Verticale ruimte","min":40,"max":140,"step":4,"default":76},{"type":"text","id":"eyebrow","label":"Label","default":"Hoe werkt het?"},{"type":"text","id":"heading","label":"Titel","default":"Van 3D-bestand naar offerte en print."}],"blocks":[{"type":"step","name":"Stap","settings":[{"type":"text","id":"title","label":"Titel","default":"Stap titel"},{"type":"textarea","id":"text","label":"Tekst","default":"Stap tekst"}]}],"presets":[{"name":"pr3nt stappen","blocks":[{"type":"step","settings":{"title":"Upload je 3D-bestand","text":"Upload STL, 3MF, OBJ, STEP of STP. Wij controleren daarna de printbaarheid."}},{"type":"step","settings":{"title":"Kies materiaal","text":"Kies PLA of PETG en geef je gewenste kleur door."}},{"type":"step","settings":{"title":"Vul je gegevens in","text":"Laat je naam, e-mail en telefoonnummer achter."}},{"type":"step","settings":{"title":"Akkoord & verzending","text":"Na jouw akkoord printen we het onderdeel. Standaard verzending duurt 3 dagen, met spoed 2 dagen."}}]}]}{% endschema %}
