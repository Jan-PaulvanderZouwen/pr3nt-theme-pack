<section class="p-section"><div class="p-wrap"><h1 class="p-title-sm">Winkelmandje</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="p-stack" style="margin-top:24px">{% for item in cart.items %}<div class="p-card p-card-body" style="display:grid;grid-template-columns:96px 1fr auto;gap:18px;align-items:center">{% if item.image %}<img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.image.alt | escape }}" style="width:96px;height:96px;object-fit:cover;border-radius:18px">{% endif %}<div><h3 class="p-card-title">{{ item.product.title }}</h3><p class="p-card-text">{{ item.variant.title }} · {{ item.final_line_price | money }}</p><input style="max-width:90px;margin-top:10px" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><a class="p-btn p-btn-outline" href="{{ item.url_to_remove }}">Verwijder</a></div>{% endfor %}</div><div class="p-highlight" style="margin-top:24px"><div><h2 style="margin:0">Totaal: {{ cart.total_price | money }}</h2><p>Verzendkosten en belastingen worden berekend bij het afrekenen.</p></div><button class="p-btn p-btn-primary" name="checkout" type="submit">Naar checkout</button></div></form>{% else %}<p class="p-copy">Je winkelmandje is leeg.</p><a class="p-btn p-btn-primary" href="/collections/all" style="margin-top:20px">Bekijk producten</a>{% endif %}</div></section>
{% schema %}{"name":"Winkelmandje","settings":[]}{% endschema %}
