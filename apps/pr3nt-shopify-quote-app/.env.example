NODE_ENV=production
PORT=3000
APP_BASE_URL=https://app.pr3nt.nl
ALLOWED_ORIGIN=https://pr3nt.nl

# Inloggen in het beheer. Verplicht op de server: zonder ADMIN_KEY of ADMIN_PASSWORD kan niemand inloggen.
# Maak lange willekeurige waarden met: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_KEY=
# Ondertekent de inlog-cookie. Leeg = ADMIN_KEY, anders een sleutel die de app zelf in de datamap bewaart.
INTERNAL_SESSION_SECRET=

SHOPIFY_SHOP=pr3nd.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Gebruik OF een legacy Admin API access token:
SHOPIFY_ADMIN_ACCESS_TOKEN=

# OF de nieuwe Shopify Dev Dashboard-flow:
SHOPIFY_CLIENT_ID=plaats-hier-je-client-id
SHOPIFY_CLIENT_SECRET=plaats-hier-je-gerouleerde-client-secret

SMTP_HOST=smtp.transip.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bestellingen@pr3nt.nl
SMTP_PASS=plaats-hier-je-mailbox-wachtwoord
MAIL_FROM=Pr3nt Offertes <bestellingen@pr3nt.nl>
MAIL_TO=bestellingen@pr3nt.nl

SUCCESS_URL=https://pr3nt.nl/pages/offerte-aanvraag-ontvangen
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads/quotes
DATA_DIR=data

# Metaobject type waarin aanvragen worden opgeslagen.
# Maak deze later in Shopify aan, of gebruik eerst de lokale JSON fallback.
QUOTE_METAOBJECT_TYPE=pr3nt_quote_request

# Website-CMS: dezelfde geheime sleutel als CMS_TOKEN in /opt/pr3nt/.env van de website (maak hem met: openssl rand -hex 32)
CMS_TOKEN=
# Waar de website draait (vanaf de VPS zelf) en het openbare adres
WEBSITE_URL=http://127.0.0.1:3200
WEBSITE_PUBLIC_URL=https://pr3nt.nl

# Webshoporders van pr3nt.nl: betaalde orders komen vanzelf in Orders (status Betaald), onbetaalde krijgen herinneringsmails.
# Hoe vaak ophalen (minuten). Zet WEBSHOP_SYNC=off om het tijdelijk uit te zetten.
WEBSHOP_SYNC_MINUTES=2
