<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#101820">
  <script src="https://t.contentsquare.net/uxa/96bfe41a477c6.js"></script>
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="3D printservice voor hobbyisten, makers en bedrijven. Upload je 3D-bestand en ontvang een duidelijke offerte voor prototypes, onderdelen en kleine series.">
  {% endif %}

  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}{% unless page_title contains shop.name %} – {{ shop.name | escape }}{% endunless %}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {% if page_description %}
    <meta property="og:description" content="{{ page_description | escape }}">
  {% else %}
    <meta property="og:description" content="Laat jouw 3D-bestand printen door pr3nt. Voor hobbyprojecten, prototypes, functionele onderdelen en zakelijke toepassingen.">
  {% endif %}
  <meta property="og:image" content="{{ 'favicon.svg' | asset_url }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page_title | escape }}{% unless page_title contains shop.name %} – {{ shop.name | escape }}{% endunless %}">
  {% if page_description %}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="twitter:description" content="3D printservice voor hobbyisten, makers en bedrijven. Upload je bestand en ontvang een duidelijke offerte.">
  {% endif %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": {{ shop.url | append: '#organization' | json }},
      "name": "pr3nt",
      "url": {{ shop.url | json }},
      "description": "3D printservice voor hobbyisten, makers en bedrijven. Pr3nt print prototypes, vervangende onderdelen, functionele onderdelen en kleine series in PLA en PETG.",
      "email": "info@pr3nt.nl",
      "telephone": "+31318507014",
      "areaServed": ["NL", "BE"],
      "priceRange": "€€"
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ shop.url | append: '#website' | json }},
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": {"@id": {{ shop.url | append: '#organization' | json }}}
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": {{ shop.url | append: '#3d-printservice' | json }},
      "name": "3D printservice",
      "serviceType": "3D printen op aanvraag",
      "provider": {"@id": {{ shop.url | append: '#organization' | json }}},
      "areaServed": ["NL", "BE"],
      "description": "3D printen van hobbyprojecten, prototypes, vervangende onderdelen en kleine series in PLA en PETG."
    }
  </script>

  {% unless request.page_type == 'index' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }}},
          {"@type": "ListItem", "position": 2, "name": {{ page_title | json }}, "item": {{ canonical_url | json }}}
        ]
      }
    </script>
  {% endunless %}

  {{ content_for_header }}
  {{ 'pr3nt.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-hero-grid.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-faq-hitboxes.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-form-progress.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-product.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-phonecase.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-phonecase-preview.css' | asset_url | stylesheet_tag }}
  {{ 'pr3nt-growth.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pr3nt.js' | asset_url }}" defer></script>
  <script src="{{ 'pr3nt-form-progress.js' | asset_url }}" defer></script>
  <script src="{{ 'pr3nt-form-error-redirect.js' | asset_url }}" defer></script>
  <script src="{{ 'pr3nt-product.js' | asset_url }}" defer></script>
  <script src="{{ 'pr3nt-phonecase.js' | asset_url }}" defer></script>
  <script src="{{ 'pr3nt-upload-indicator.js' | asset_url }}" defer></script>
</head>
<body>
  {% section 'pr3nt-header' %}
  <main id="MainContent" role="main">{{ content_for_layout }}</main>
  {% section 'pr3nt-footer' %}
</body>
</html>